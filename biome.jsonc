{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": ["package.json", "README.md", "src"]
  },
  "javascript": {
    "formatter": {
      "lineWidth": 120,
      "indentStyle": "tab",
      "indentWidth": 2,
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noUnknownAtRules": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":BUN:", ":NODE:", "react"]
          }
        }
      }
    }
  }
}
